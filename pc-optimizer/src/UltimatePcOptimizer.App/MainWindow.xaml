<Window x:Class="UltimatePcOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Ultimate PC Optimizer" Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        Icon="Assets/app.ico" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedPages" Source="{Binding Pages}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,18">
                    <Grid Width="34" Height="34">
                        <Ellipse Stroke="{StaticResource AccentGradientBrush}" StrokeThickness="4" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ULTIMATE" FontWeight="Black" FontSize="15" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="PC OPTIMIZER" FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Barcha o'zgarishlar qaytariladi" Style="{StaticResource Muted}" FontSize="11" Margin="24,12,16,16" />
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedPages}}" SelectedItem="{Binding CurrentPage}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="26,14,0,4" Opacity="0.75" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" Width="22" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Title bar -->
        <Grid Grid.Column="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <TextBlock Text="{Binding CurrentPage.Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                <Border Style="{StaticResource Badge}" Margin="14,0,0,0" Visibility="{Binding SessionBadge, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding SessionBadge}" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource ChromeButton}" Click="OnMinimize" />
                <Button Content="&#xE922;" Style="{StaticResource ChromeButton}" Click="OnMaximize" />
                <Button Content="&#xE8BB;" Style="{StaticResource ChromeButton}" Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- Page host -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="PageOffset" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- Toast -->
        <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="720"
                Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="18,12" BorderThickness="1"
                Visibility="{Binding Notifier.IsVisible, Converter={StaticResource Visible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifier.IsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
            </Border.Effect>
            <TextBlock Text="{Binding Notifier.Message}" Style="{StaticResource Body}" />
        </Border>
    </Grid>
</Window>
