<Window x:Class="UltimatePcOptimizer.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UltimatePcOptimizer.App.Converters"
        Title="Tasdiqlash" Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <conv:StateToBrushConverter x:Key="StateBrush" />
        <conv:EnumTextConverter x:Key="EnumText" />
    </Window.Resources>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                <Border x:Name="RiskBadge" Style="{StaticResource Badge}" Margin="12,0,0,0">
                    <TextBlock x:Name="RiskText" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Margin="0,0,0,12" />
            <ItemsControl x:Name="DetailsList" MaxHeight="300">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Bekor qilish" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel" />
                <Button Content="Ruxsat beraman" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
