<Window x:Class="UltimatePcOptimizer.App.Views.FpsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Left="16" Top="16" FontFamily="Consolas">
    <Border Background="#B30A0C11" CornerRadius="8" Padding="10,6" BorderBrush="#5500E5FF" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="FpsText" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" Text="— FPS" />
            <TextBlock x:Name="LowText" Foreground="#E7EAF2" FontSize="12" />
            <TextBlock x:Name="FrameText" Foreground="#E7EAF2" FontSize="12" />
            <TextBlock x:Name="CpuText" Foreground="#8B94A8" FontSize="12" />
            <TextBlock x:Name="GpuText" Foreground="#8B94A8" FontSize="12" />
            <TextBlock x:Name="RamText" Foreground="#8B94A8" FontSize="12" />
        </StackPanel>
    </Border>
</Window>
