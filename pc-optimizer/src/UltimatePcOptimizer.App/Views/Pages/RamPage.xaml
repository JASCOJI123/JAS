<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.RamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RamViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <DockPanel Margin="0,0,14,18">
                <Button DockPanel.Dock="Right" Content="Yangilash" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0" />
                <StackPanel>
                    <TextBlock Text="RAM Optimizer" Style="{StaticResource H1}" />
                    <TextBlock Text="RAM sun'iy tozalanmaydi va faol dasturlar majburan yopilmaydi — qaysi dastur qancha xotira olayotganini ko'rsatamiz, qarorni siz qabul qilasiz."
                               Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <p:BusyStatus />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <c:RadialGauge Height="170" Label="RAM" Value="{Binding Snapshot.Memory.UsedPercent}" Caption="{Binding Snapshot.Memory.UsedBytes, Converter={StaticResource Bytes}}" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="Ishlatilgan / jami" Style="{StaticResource Muted}" /><TextBlock Style="{StaticResource StatValue}" FontSize="18"><Run Text="{Binding Snapshot.Memory.UsedBytes, Converter={StaticResource Bytes}, Mode=OneWay}" /> / <Run Text="{Binding Snapshot.Memory.TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" /></TextBlock></StackPanel>
                            <StackPanel><TextBlock Text="Commit (virtual)" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Snapshot.Memory.CommitPercent, StringFormat='{}{0:0}%'}" Style="{StaticResource StatValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="RAM bosimi" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Assessment.Pressure, FallbackValue='—'}" Style="{StaticResource StatValue}" Foreground="{Binding Assessment.Pressure, Converter={StaticResource StateBrush}}" /></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding Assessment.Message}" Style="{StaticResource Body}" Margin="0,10,0,4" />
                        <TextBlock Style="{StaticResource Muted}"><Run Text="Virtual Memory / Pagefile: " /><Run Text="{Binding PageFileText, Mode=OneWay}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Assessment.Advice}" Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Body}" Foreground="{StaticResource WarningBrush}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:Sparkline Height="70" Values="{Binding History}" Stroke="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Eng ko'p RAM sarflayotgan dasturlar" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding TopProcesses}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jarayon" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="RAM" Binding="{Binding WorkingSetBytes, Converter={StaticResource Bytes}}" Width="100" />
                            <DataGridTextColumn Header="Turi" Binding="{Binding Category}" Width="130" />
                            <DataGridCheckBoxColumn Header="Himoyalangan" Binding="{Binding IsProtected}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
