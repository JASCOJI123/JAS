<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProcessesViewModel}">
    <DockPanel Margin="28,22,14,10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Background Process Manager" Style="{StaticResource H1}" />
            <TextBlock Text="Tizim, xavfsizlik va anti-cheat jarayonlari himoyalangan. Ustuvorlik o'zgarishlari jurnalga yoziladi." Style="{StaticResource Muted}" Margin="0,4,14,14" />
            <p:BusyStatus />
            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" MinWidth="130" Margin="0,0,8,0" />
                        <Button Content="Ustuvorlikni o'rnatish" Style="{StaticResource GhostButton}" Command="{Binding SetPriorityCommand}" />
                        <Button Content="Jarayonni yopish" Style="{StaticResource DangerButton}" Command="{Binding EndProcessCommand}" />
                        <Button Content="Yangilash" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,14,0" ToolTip="Qidirish" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideSystem}" Content="Himoyalanganlarni yashirish" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Jarayon" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}" Width="70" />
                    <DataGridTextColumn Header="RAM" Binding="{Binding WorkingSetBytes, Converter={StaticResource Bytes}}" Width="90" />
                    <DataGridTextColumn Header="Ustuvorlik" Binding="{Binding Priority}" Width="100" />
                    <DataGridTextColumn Header="Turi" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn Header="Yo'l" Binding="{Binding ExecutablePath}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
