<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.FpsBoosterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FpsBoosterViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <DockPanel Margin="0,0,14,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Qayta tekshirish" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="Windows grafikani optimallashtirish" Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeWindowsGraphicsCommand}" Margin="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FPS Booster" Style="{StaticResource H1}" />
                    <TextBlock Text="Drayverlar majburan o'zgartirilmaydi, overclock qo'llanmaydi, o'yin fayllariga tegilmaydi." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
            <p:BusyStatus />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GPU sozlamalari" Style="{StaticResource H2}" />
                        <TextBlock Text="Videokarta" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding GpuName}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Ishlab chiqaruvchi · drayver" Style="{StaticResource Muted}" />
                        <TextBlock Margin="0,0,0,8"><Run Text="{Binding GpuVendor, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DriverVersion, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="HAGS (Hardware-accelerated GPU scheduling)" Style="{StaticResource Muted}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Graphics settings" Style="{StaticResource SmallButton}" Command="{Binding OpenGraphicsSettingsCommand}" Margin="0" />
                            <TextBlock Text="{Binding HagsText}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="NVIDIA Reflex" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ReflexText}" Style="{StaticResource Body}" Margin="0,0,0,8" />
                        <TextBlock Text="Windows Game Mode · Game DVR" Style="{StaticResource Muted}" />
                        <TextBlock><Run Text="{Binding GameModeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding GameDvrText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FPS pasayishiga sabab bo'layotgan fon jarayonlari" Style="{StaticResource H2}" />
                        <TextBlock Text="Bular yopilmaydi — Gaming Booster o'yin vaqtida ularning ustuvorligini vaqtincha pasaytiradi." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding FpsImpactProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold">
                                            <Run Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%', Mode=OneWay}" /> <Run Text="CPU" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MinWidth="240">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="O'yin uchun grafik profil" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="4" DataContext="{Binding Profile}">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Preset" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Preset}" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Maqsad FPS" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding TargetFps}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Upscaling" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Upscaler}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="Latency" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding LatencyAdvice}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock DataContext="{Binding Profile}" Text="{Binding SyncAdvice}" Style="{StaticResource Body}" Margin="0,6,0,6" />
                    <ItemsControl ItemsSource="{Binding Profile.Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Muted}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
