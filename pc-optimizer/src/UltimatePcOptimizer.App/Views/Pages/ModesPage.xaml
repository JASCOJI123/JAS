<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.ModesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModesViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <TextBlock Text="Optimization Modes" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,14,18">
                <Run Text="Faol rejim: " /><Run Text="{Binding ActiveMode, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                <Run Text=" · Har bir rejim bitta guruh sifatida jurnalga yoziladi va Undo qilinadi." />
            </TextBlock>
            <p:BusyStatus />

            <ItemsControl ItemsSource="{Binding Modes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="Qo'llash" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}">
                                        <Run Text="Power Plan: " /><Run Text="{Binding PowerPlan, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Custom Optimization" Style="{StaticResource H2}" />
                    <TextBlock Text="Faqat o'zingiz tanlagan sozlamalar qo'llanadi. Allaqachon qo'llangan sozlamalar belgilangan." Style="{StaticResource Muted}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Tweaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TweakItem}">
                                <Border Style="{StaticResource InnerCard}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding Tweak.Risk, Converter={StaticResource EnumText}}" FontSize="11"
                                                       Foreground="{Binding Tweak.Risk, Converter={StaticResource StateBrush}}" />
                                        </Border>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsApplied, Converter={x:Static p:Inverse.Instance}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Tweak.Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Tweak.Description}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Power Plan:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding PlanOptions}" SelectedItem="{Binding CustomPlan}" Margin="0,0,14,0" />
                        <Button Content="Custom qo'llash" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCustomCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
