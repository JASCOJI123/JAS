<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.GamingBoosterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GamingBoosterViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <TextBlock Text="Gaming Booster" Style="{StaticResource H1}" />
            <TextBlock Text="O'yin ishga tushganda Gaming Mode avtomatik yoqiladi va o'yin yopilganda barcha sozlamalar tiklanadi. Anti-cheat jarayonlari va o'yin fayllariga hech qachon tegilmaydi."
                       Style="{StaticResource Muted}" Margin="0,4,14,18" />
            <p:BusyStatus />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Holat" Style="{StaticResource H2}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="12" Height="12" Fill="{Binding IsSessionActive, Converter={StaticResource StateBrush}}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding SessionText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SessionChanges}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='✓ {0}'}" Style="{StaticResource Muted}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoDetection}" Content="O'yinlarni avtomatik aniqlash" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoBoostNewGames}" Content="O'yin ishga tushganda Gaming Mode'ni avtomatik yoqish" />
                        <TextBlock Text="Ishlayotgan o'yin" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                        <ComboBox ItemsSource="{Binding RunningGames}" SelectedItem="{Binding SelectedRunningGame}" HorizontalAlignment="Left" MinWidth="260">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding GameName}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Hozir boost qilish" Style="{StaticResource PrimaryButton}" Command="{Binding BoostNowCommand}" />
                            <Button Content="Sessiyani tugatish va tiklash" Style="{StaticResource GhostButton}" Command="{Binding EndSessionCommand}"
                                    IsEnabled="{Binding IsSessionActive}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Qo'llab-quvvatlanadigan o'yinlar" Style="{StaticResource H2}" />
                        <TextBlock Text="Steam, Epic va Riot kutubxonalaridagi boshqa o'yinlar ham avtomatik aniqlanadi." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding SupportedGames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,6" Padding="10,4">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="O'yin profillari" Style="{StaticResource H2}" />
                    <TextBlock Text="Profil yo'q bo'lsa, o'yin birinchi marta aniqlanganda ruxsat so'raladi. Game Library'dan ham profil yaratish mumkin."
                               Style="{StaticResource Muted}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameProfileItem}">
                                <Border Style="{StaticResource InnerCard}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Saqlash" Style="{StaticResource SmallButton}" Margin="0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding HasKernelAntiCheat, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="Kernel anti-cheat — o'yin jarayoniga tegilmaydi" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoBoost}" Content="Auto boost" Margin="0,4,18,4" />
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseHighPerformancePowerPlan}" Content="High Performance" Margin="0,4,18,4" />
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SuppressNotifications}" Content="Bildirishnomalar o'chiq" Margin="0,4,18,4" />
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LowerBackgroundPriority}" Content="Fonni cheklash" Margin="0,4,18,4" />
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RaiseGamePriority}" Content="O'yin ustuvorligi"
                                                          IsEnabled="{Binding HasKernelAntiCheat, Converter={x:Static p:Inverse.Instance}}" Margin="0,4,18,4" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
