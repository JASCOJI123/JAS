<UserControl x:Class="UltimatePcOptimizer.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePcOptimizer.App.Controls"
             xmlns:p="clr-namespace:UltimatePcOptimizer.App.Views.Pages"
             xmlns:vm="clr-namespace:UltimatePcOptimizer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <DockPanel Margin="0,0,14,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Yangilash" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" CommandParameter="optimize" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="ONE CLICK OPTIMIZE" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding CpuName, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding GpuName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <p:BusyStatus />

            <!-- Gauges -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <c:RadialGauge Height="150" Label="CPU" Value="{Binding Snapshot.CpuLoadPercent}"
                                   Caption="{Binding Snapshot.CpuTemperatureC, Converter={StaticResource Fmt}, ConverterParameter='{}{0:0}°C'}" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <c:RadialGauge Height="150" Label="GPU" Value="{Binding Snapshot.GpuLoadPercent, TargetNullValue=0}"
                                   Caption="{Binding Snapshot.GpuTemperatureC, Converter={StaticResource Fmt}, ConverterParameter='{}{0:0}°C'}" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <c:RadialGauge Height="150" Label="RAM" Value="{Binding Snapshot.Memory.UsedPercent}"
                                   Caption="{Binding Snapshot.Memory.UsedBytes, Converter={StaticResource Bytes}}" />
                </Border>
                <Border Style="{StaticResource Card}">
                    <c:RadialGauge Height="150" Label="DISK" Value="{Binding Snapshot.DiskActivityPercent}" Caption="faollik" />
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System Health Score" Style="{StaticResource H2}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Health.Score, FallbackValue='—'}" FontSize="54" FontWeight="Black"
                                       Foreground="{Binding Health.Status, Converter={StaticResource StateBrush}}" />
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding Health.StatusText, FallbackValue='Tahlil…'}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Holat: " /><Run Text="{Binding PerformanceState, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Health.Factors}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold">
                                            <Run Text="−" /><Run Text="{Binding Penalty, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="CPU harorati" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Snapshot.CpuTemperatureC, Converter={StaticResource Fmt}, ConverterParameter='{}{0:0} °C'}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="GPU harorati" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Snapshot.GpuTemperatureC, Converter={StaticResource Fmt}, ConverterParameter='{}{0:0} °C'}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Windows yuklanish vaqti" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding BootTimeText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Faol jarayonlar" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Snapshot.ProcessCount}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ishlash vaqti (uptime)" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding UptimeText}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="RAM" Style="{StaticResource Muted}" />
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="{Binding Snapshot.Memory.UsedBytes, Converter={StaticResource Bytes}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Snapshot.Memory.TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- Charts -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU — 2 daqiqa" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <c:Sparkline Height="70" Values="{Binding CpuHistory}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GPU — 2 daqiqa" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <c:Sparkline Height="70" Values="{Binding GpuHistory}" Stroke="{StaticResource Accent2Brush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RAM — 2 daqiqa" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <c:Sparkline Height="70" Values="{Binding RamHistory}" Stroke="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recommendations -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Recommendations.Count, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Tavsiyalar" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Ochish" Style="{StaticResource SmallButton}" Margin="0"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Page}" Visibility="{Binding Page, Converter={StaticResource Visible}}" />
                                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{Binding Severity, Converter={StaticResource StateBrush}}" Margin="0,0,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
